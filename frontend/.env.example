# ── FRONTEND ENVIRONMENT VARIABLES ────────────────────────────────────────────
# Copy this file to .env in the frontend/ directory:
#   cp .env.example .env

# Backend API base URL (include trailing slash)
# Local development:
VITE_API_URL=http://localhost:8000/api/
# Production (set this on Vercel):
# VITE_API_URL=https://your-backend.onrender.com/api/

# Google OAuth 2.0 Web Client ID for Google Sign In / Sign Up (Google Identity Services)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web Application)
# Example: 123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

