# ── FRONTEND ENVIRONMENT VARIABLES ────────────────────────────────────────────
# Copy this file to .env in the frontend/ directory:
#   cp .env.example .env

# Backend API base URL (include trailing slash)
# Local development:
VITE_API_URL=http://localhost:8000/api/
# Production (set this on Vercel):
# VITE_API_URL=https://your-backend.onrender.com/api/

# Google OAuth Client ID for live Google Sign In / Sign Up (Google Identity Services)
# Leave empty to use the built-in zero-config interactive Google Sandbox Simulator in development
VITE_GOOGLE_CLIENT_ID=

