# ── CORE DJANGO ──────────────────────────────────────────────────────────────
# Generate a real secret with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

DEBUG=False

# ── JWT ───────────────────────────────────────────────────────────────────────
# Should be the same as SECRET_KEY, or a separate long random string
JWT_SECRET_KEY=your-jwt-secret-key-here

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Leave empty to use SQLite (local dev only). Set to Postgres URL in production.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=

# ── AI / Gemini ───────────────────────────────────────────────────────────────
# Get a free key from https://aistudio.google.com/app/apikey (no payment required)
GEMINI_API_KEY=your-gemini-api-key-here

# ── EMAIL ─────────────────────────────────────────────────────────────────────
# Options: "console" (dev, prints to stdout) or "sendgrid" (production)
EMAIL_PROVIDER=console
# SendGrid API key — required only when EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=SG.your-sendgrid-api-key-here
EMAIL_FROM=noreply@ayusetu.com

# ── GOOGLE CALENDAR ───────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Local:      http://localhost:8000/api/calendar/callback/
# Production: https://your-backend.onrender.com/api/calendar/callback/
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/callback/

# ── REDIS (Django-Q async workers) ────────────────────────────────────────────
# Leave empty for synchronous ORM fallback (default for local dev / Windows)
# Production example: redis://default:password@your-upstash-host:port
REDIS_URL=

# ── CORS / URL REFERENCES ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ── DJANGO-Q BEHAVIOUR ────────────────────────────────────────────────────────
# True = tasks run inline (synchronous) — use for Windows dev / CI
# False = tasks run in background workers — use in production
DJANGO_Q_SYNC=True
